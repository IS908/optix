# Claude project files
.claude/

# Compiled Go binaries (anchored to root so proto/optix/ and gen/go/optix/ are NOT ignored)
/optix
/optix-cli
/optix-server
bin/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
.mypy_cache/

# Virtualenv
.venv/
venv/

# SQLite data (runtime state, not source) — ignore entire data/ dir
data/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Agent workflow scaffolding (brainstorming specs + execution plans).
# These are working artifacts of the design/planning loop, not maintained
# documentation. The rationale that produced any merged feature lives in
# its commit messages and PR description.
docs/superpowers/plans/
docs/superpowers/specs/

# Local superpowers scratch space (skill state, runtime overrides).
.superpowers/
